<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>SeaDAS</string>
    <key>CFBundleIconFile</key>
    <string>SeaDAS.icns</string>
    <key>CFBundleIdentifier</key>
    <string>gov.nasa.gsfc.seadas</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>SeaDAS</string>
    <key>CFBundleDisplayName</key>
    <string>SeaDAS</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.education</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
    </array>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>NASA Ocean Biology Processing Group. Licensed under GPL-3.0.</string>
    <!-- Shown by macOS when SeaDAS first opens files in these places. -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>SeaDAS opens and saves data files you choose on the Desktop.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>SeaDAS opens and saves data files you choose in Documents.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>SeaDAS opens data files you downloaded.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>SeaDAS opens and saves data files on network drives.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>SeaDAS opens and saves data files on external drives.</string>
</dict>
</plist>
