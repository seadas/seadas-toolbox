#!/bin/sh

set -eu

progname=$(basename "$0")
linkdir=$(dirname "$0")

old_pwd=$(pwd)
cd "$linkdir"

prg="$progname"
while [ -h "$prg" ]; do
  ls_out=$(ls -ld "$prg")
  link=$(expr "$ls_out" : '.*-> \(.*\)$')
  if expr "$link" : '.*/.*' >/dev/null; then
    prg="$link"
  else
    prg="$(dirname "$prg")/$link"
  fi
done

prg_dir=$(dirname "$prg")
cd "$prg_dir"
prg_dir=$(pwd)

cd "$prg_dir/.."
app_home=$(pwd)
cd "$old_pwd"

EXCLUDED1="org-esa-snap-snap-worldwind.jar"
EXCLUDED2="org-esa-snap-snap-python.jar"

build_jar_classpath() {
  search_dir=$1
  exclude1=$2
  exclude2=$3

  [ -d "$search_dir" ] || return 0

  find "$search_dir" -type f -name '*.jar' \
    ! -name "$exclude1" \
    ! -name "$exclude2" \
    -print \
    | while IFS= read -r jar; do
        printf '%s:' "$jar"
      done
}

build_native_lib_path() {
  search_dir=$1

  [ -d "$search_dir" ] || return 0

  find "$search_dir" -type f \( -name '*.so' -o -name '*.so.*' \) -print \
    | while IFS= read -r lib; do
        dirname "$lib"
      done \
    | awk '!seen[$0]++' \
    | while IFS= read -r dir; do
        printf '%s:' "$dir"
      done
}

SNAP_MODULE_PATH="$app_home/snap/modules"
OPTTBX_MODULE_PATH="$app_home/optical-toolbox/modules"
SEADAS_TOOLBOX_MODULE_PATH="$app_home/seadas-toolbox/modules"
PLATFORM_LIB_PATH="$app_home/platform/lib"
PLATFORM_MODULE_PATH="$app_home/platform/modules"
IDE_MODULE_PATH="$app_home/ide/modules"

SNAP_MODULE_JARS=$(build_jar_classpath "$SNAP_MODULE_PATH" "$EXCLUDED1" "$EXCLUDED2")
SNAP_MODULE_JARS=${SNAP_MODULE_JARS%:}

OPTTBX_MODULE_JARS=$(build_jar_classpath "$OPTTBX_MODULE_PATH" "$EXCLUDED1" "$EXCLUDED2")
OPTTBX_MODULE_JARS=${OPTTBX_MODULE_JARS%:}

SEADAS_TOOLBOX_MODULE_JARS=$(build_jar_classpath "$SEADAS_TOOLBOX_MODULE_PATH" "$EXCLUDED1" "$EXCLUDED2")
SEADAS_TOOLBOX_MODULE_JARS=${SEADAS_TOOLBOX_MODULE_JARS%:}

PLATFORM_LIB_JARS=$(build_jar_classpath "$PLATFORM_LIB_PATH" "" "")
PLATFORM_LIB_JARS=${PLATFORM_LIB_JARS%:}

PLATFORM_MODULE_JARS=$(build_jar_classpath "$PLATFORM_MODULE_PATH" "" "")
PLATFORM_MODULE_JARS=${PLATFORM_MODULE_JARS%:}

IDE_MODULE_JARS=$(build_jar_classpath "$IDE_MODULE_PATH" "" "")
IDE_MODULE_JARS=${IDE_MODULE_JARS%:}

JAVA_LIBRARY_PATH=$(build_native_lib_path "$app_home")
JAVA_LIBRARY_PATH=${JAVA_LIBRARY_PATH%:}

SLF4J_API_JAR="$app_home/snap/modules/ext/org.esa.snap.ceres-core/org-slf4j/slf4j-api.jar"
SLF4J_SIMPLE_JAR="$app_home/snap/modules/ext/org.esa.snap.snap-netcdf/org-slf4j/slf4j-simple.jar"

SLF4J_PREFIX=""
if [ -f "$SLF4J_API_JAR" ] && [ -f "$SLF4J_SIMPLE_JAR" ]; then
  SLF4J_PREFIX="$SLF4J_API_JAR:$SLF4J_SIMPLE_JAR:"
fi

local_classpath="${SLF4J_PREFIX}$PLATFORM_LIB_JARS:$PLATFORM_MODULE_JARS:$IDE_MODULE_JARS:$SNAP_MODULE_JARS:$OPTTBX_MODULE_JARS:$SEADAS_TOOLBOX_MODULE_JARS"
local_classpath=${local_classpath#:}
local_classpath=${local_classpath%:}

if [ -x "$app_home/jdk-21.0.8+9-jre/bin/java" ]; then
  java_exec="$app_home/jdk-21.0.8+9-jre/bin/java"
elif [ -n "${JAVA_HOME:-}" ] && [ -x "${JAVA_HOME}/bin/java" ]; then
  java_exec="${JAVA_HOME}/bin/java"
else
  java_exec=$(command -v java || true)
fi

if [ -z "${java_exec:-}" ] || [ ! -x "$java_exec" ]; then
  echo "No suitable Java executable found."
  echo "Set JAVA_HOME or bundle a JRE with SeaDAS."
  exit 83
fi

VMOPTIONS_ARGS=""
vmoptions_file="$prg_dir/$progname.vmoptions"

if [ -r "$vmoptions_file" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*)
        continue
        ;;
      *)
        if [ -z "$VMOPTIONS_ARGS" ]; then
          VMOPTIONS_ARGS=$line
        else
          VMOPTIONS_ARGS="$VMOPTIONS_ARGS
$line"
        fi
        ;;
    esac
  done < "$vmoptions_file"
fi

NETBEANS_USER_DIR="$app_home/var/netbeans-user"
mkdir -p "$NETBEANS_USER_DIR" >/dev/null 2>&1

if [ -n "$JAVA_LIBRARY_PATH" ]; then
  export LD_LIBRARY_PATH="$JAVA_LIBRARY_PATH${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

echo "----------------------------------------"
echo "GPT Launcher Debug Info"
echo "app_home: $app_home"
echo "java_exec: $java_exec"
echo "vmoptions_file: $vmoptions_file"
"$java_exec" -version 2>&1
echo "----------------------------------------"

set -- \
  -Dexe4j.moduleName="$prg_dir/$progname" \
  "-Djava.library.path=$JAVA_LIBRARY_PATH" \
  "-Dnetbeans.user=$NETBEANS_USER_DIR" \
  "-Dsnap.mainClass=org.esa.snap.core.gpf.main.GPT" \
  "-Dsnap.home=$app_home" \
  "-Djava.awt.headless=true" \
  -classpath "$local_classpath" \
  org.esa.snap.runtime.Launcher \
  "$@"

if [ -n "$VMOPTIONS_ARGS" ]; then
  old_ifs=${IFS-}
  IFS='
'
  for opt in $VMOPTIONS_ARGS; do
    set -- "$opt" "$@"
  done
  IFS=$old_ifs
fi

exec "$java_exec" "$@"