<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!--
  Shortcut specification for Linux / Unix.

  IzPack's ShortcutPanelLogic looks this up as
  TargetFactory.getCurrentOSPrefix() + "shortcutSpec.xml", so the descriptor
  must declare it with id "Unix_shortcutSpec.xml".  If the id does not match,
  the lookup throws and the exception is swallowed - no shortcut is created
  and nothing is logged.
-->
<izpack:shortcuts version="5.0"
                  xmlns:izpack="http://izpack.org/schema/shortcuts"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://izpack.org/schema/shortcuts http://izpack.org/schema/5.0/izpack-shortcuts-5.0.xsd">

    <skipIfNotSupported/>

    <programGroup defaultName="SeaDAS" location="applications"/>

    <shortcut
            name="SeaDAS"
            programGroup="yes"
            desktop="yes"
            applications="yes"
            type="Application"
            startMenu="yes"
            startup="no"
            target="$INSTALL_PATH/bin/seadas"
            commandLine=""
            description="SeaDAS - NASA Ocean Biology Processing Group toolbox"
            iconFile="$INSTALL_PATH/bin/app.png"
            iconIndex="0"
            initialState="noShow">
        <createForPack name="snap"/>
    </shortcut>

</izpack:shortcuts>
