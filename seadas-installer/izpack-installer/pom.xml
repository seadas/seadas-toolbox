<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>gov.nasa.gsfc.seadas</groupId>
    <artifactId>izpack-installer</artifactId>
    <version>1.2</version>
    <name>SeaDAS Installer</name>
    <packaging>jar</packaging>

    <!-- maven repository where the izpack-maven-plugin and such live -->
    <repositories>
        <repository>
            <id>codehaus-releases</id>
            <url>https://nexus.codehaus.org/content/repositories/releases</url>
        </repository>
    </repositories>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <staging.dir>${project.build.directory}/staging</staging.dir>
        <izpack.version>5.2.4</izpack.version>

        <!--
            installer.source and installer.platform are supplied by the mac / linux
            / win profiles below.  There is deliberately no default: a build without
            -P would otherwise silently produce an installer for the wrong platform.
            Build with one of:

                mvn package -P mac      (macOS, Apple Silicon)
                mvn package -P linux
                mvn package -P win

            Add the nojre profile for an installer that does not bundle a JRE and
            uses a JDK 21+ already on the machine instead, e.g. -P linux,nojre.
        -->
        <installer.descriptor>${installer.source}</installer.descriptor>
        <installer-output-filename>seadas-installer-${installer.platform}</installer-output-filename>
        <!-- Set by the nojre profile.  Only the Windows Inno Setup input uses it. -->
        <windows.nojre>false</windows.nojre>
    </properties>

    <profiles>
        <profile>
            <id>mac</id>
            <properties>
                <installer.source>install-for-mac.xml</installer.source>
                <installer.platform>macos-aarch64</installer.platform>
            </properties>
        </profile>

        <profile>
            <id>linux</id>
            <properties>
                <installer.source>install-for-linux.xml</installer.source>
                <installer.platform>linux-x64</installer.platform>
            </properties>
        </profile>

        <profile>
            <id>win</id>
            <properties>
                <installer.source>install-for-windows.xml</installer.source>
                <installer.platform>windows-x64</installer.platform>
            </properties>
            <build>
                <plugins>
                    <!-- Launch4j: wrap the installer JAR into a Windows EXE.
                         Only meaningful for the Windows build. -->
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <version>2.6.0</version>
                        <executions>
                            <execution>
                                <id>l4j-gui</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>launch4j</goal>
                                </goals>
                                <configuration>
                                    <headerType>gui</headerType>

                                    <!-- This now matches the IzPack output exactly -->
                                    <jar>${project.build.directory}/${installer-output-filename}.jar</jar>

                                    <outfile>target/${installer-output-filename}.exe</outfile>
                                    <classPath>
                                        <mainClass>com.izforge.izpack.installer.bootstrap.Installer</mainClass>
                                    </classPath>
                                    <jre>
                                        <requires64Bit>true</requires64Bit>
                                        <minVersion>21.0.0</minVersion>
                                        <!-- No maxVersion: any Java 21+ may run the installer.
                                             This only picks the JVM that runs the .exe; SeaDAS
                                             itself runs on the bundled JRE or, for nojre, on
                                             the JDK chosen on the JDKPathPanel. -->

                                    </jre>
                                    <versionInfo>
                                        <fileVersion>1.0.0.0</fileVersion>
                                        <txtFileVersion>${project.version}</txtFileVersion>
                                        <fileDescription>${project.name}</fileDescription>
                                        <copyright>C</copyright>
                                        <productVersion>1.0.0.0</productVersion>
                                        <txtProductVersion>1.0.0.0</txtProductVersion>
                                        <productName>${project.name}</productName>
                                        <internalName>SeaDAS</internalName>
                                        <originalFilename>${installer-output-filename}.exe</originalFilename>
                                    </versionInfo>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Inno Setup input for the final Windows installer: lays out the
                         installed SeaDAS folder as target/windows/SeaDAS, the way the
                         IzPack installer would install it, and copies the Inno script
                         from ../windows-installer-files next to it.  build-all.sh
                         compiles it with ISCC.  With nojre the JRE is left out and the
                         Inno installer asks for a Java 21+ on the machine instead. -->
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>1.8</version>
                        <executions>
                            <execution>
                                <id>windows-inno-input</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                        <property name="win.dir" value="${project.build.directory}/windows"/>
                                        <property name="app.dir" value="${win.dir}/SeaDAS"/>
                                        <property name="packs" value="${staging.dir}/packs"/>
                                        <property name="descriptor" value="${staging.dir}/${installer.source}"/>

                                        <!-- Read the values IzPack would substitute from the
                                             descriptor, so they are not kept in two places. -->
                                        <macrodef name="descriptor-value">
                                            <attribute name="property"/>
                                            <attribute name="contains"/>
                                            <attribute name="pattern"/>
                                            <sequential>
                                                <loadfile property="@{property}" srcfile="${descriptor}">
                                                    <filterchain>
                                                        <linecontains>
                                                            <contains value="@{contains}"/>
                                                        </linecontains>
                                                        <tokenfilter>
                                                            <replaceregex pattern="@{pattern}" replace="\1"/>
                                                        </tokenfilter>
                                                        <striplinebreaks/>
                                                    </filterchain>
                                                </loadfile>
                                                <fail message="${installer.source}: no value found for @{contains}"
                                                      unless="@{property}"/>
                                            </sequential>
                                        </macrodef>
                                        <descriptor-value property="max.heap"
                                                          contains="name=&quot;installer:maxHeapSize&quot;"
                                                          pattern=".*value=&quot;([^&quot;]+)&quot;.*"/>
                                        <descriptor-value property="extra.clusters"
                                                          contains="name=&quot;extra_clusters&quot;"
                                                          pattern=".*value=&quot;([^&quot;]+)&quot;.*"/>
                                        <descriptor-value property="jre.dir"
                                                          contains="name=&quot;jdkhome&quot;"
                                                          pattern=".*\\([^\\&quot;]+)&quot;.*"/>
                                        <descriptor-value property="jre.archive"
                                                          contains="src=&quot;packs/jre/"
                                                          pattern=".*src=&quot;([^&quot;]+)&quot;.*"/>

                                        <!-- The SeaDAS version, from the seadas-toolbox root pom -->
                                        <xmlproperty file="${basedir}/../../pom.xml" prefix="root" keepRoot="true"/>
                                        <fail message="no version in ../../pom.xml" unless="root.project.version"/>

                                        <delete dir="${win.dir}"/>

                                        <!-- Same filesets as the snap, opttbx, seadas-toolbox and
                                             JRE packs in install-for-windows.xml -->
                                        <copy todir="${app.dir}">
                                            <fileset dir="${packs}/snap" excludes="bin/*, etc/*"/>
                                        </copy>
                                        <copy todir="${app.dir}" overwrite="true">
                                            <fileset dir="${packs}/files/winx64"/>
                                        </copy>
                                        <copy todir="${app.dir}/optical-toolbox">
                                            <fileset dir="${packs}/opttbx"/>
                                        </copy>
                                        <copy todir="${app.dir}/seadas-toolbox">
                                            <fileset dir="${packs}/seadas"/>
                                        </copy>
                                        <unzip src="${staging.dir}/${jre.archive}" dest="${app.dir}"
                                               unless:true="${windows.nojre}"/>
                                        <available file="${app.dir}/${jre.dir}/bin/java.exe" property="jre.ok"/>
                                        <fail message="${jre.archive} did not unpack to ${jre.dir}"
                                              unless:true="${windows.nojre}" unless="jre.ok"/>

                                        <!-- IzPack's parsable etc files.  ${jdkhome} stays: the
                                             Inno installer fills it in with the folder the user
                                             picks.  ${HOME} is for the SeaDAS launcher, not IzPack. -->
                                        <replace dir="${app.dir}/etc"
                                                 includes="seadas.clusters, seadas.conf, seadas.properties, snap.clusters, snap.conf, snap.properties">
                                            <replacefilter token="$${installer:maxHeapSize}" value="${max.heap}"/>
                                            <replacefilter token="$${extra_clusters}" value="${extra.clusters}"/>
                                        </replace>

                                        <copy todir="${win.dir}">
                                            <fileset dir="${basedir}/../windows-installer-files"
                                                     includes="*.iss, *.rtf, *.ico"/>
                                        </copy>
                                        <echo file="${win.dir}/build.iss">; Written by 'mvn package -P win' (izpack-installer/pom.xml)
#define MyAppVersion "${root.project.version}"
#define JreDir "${jre.dir}"
</echo>
                                        <!-- Maven trims the text above, final newline included -->
                                        <echo file="${win.dir}/build.iss" append="true" message="&#10;"/>
                                        <echo file="${win.dir}/build.iss" append="true"
                                              if:true="${windows.nojre}" message="#define NoJre&#10;"/>
                                        <!-- ISCC runs in Docker as another user and needs to
                                             write its output here. -->
                                        <mkdir dir="${win.dir}/out"/>
                                        <chmod dir="${win.dir}/out" perm="a+rwx" type="dir"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Combine with mac, linux or win.  Derives the descriptor from that
             platform's install-for-*.xml with src/main/xslt/without-bundled-jre.xsl,
             so there is no second descriptor to keep in sync by hand.  Must stay
             declared after the platform profiles: it overrides their properties. -->
        <profile>
            <id>nojre</id>
            <properties>
                <installer.descriptor>without-bundled-jre-${installer.source}</installer.descriptor>
                <installer-output-filename>seadas-installer-${installer.platform}-nojre</installer-output-filename>
                <windows.nojre>true</windows.nojre>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>1.8</version>
                        <executions>
                            <execution>
                                <id>derive-nojre-descriptor</id>
                                <!-- after validate, which fills the staging directory -->
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <xslt in="${staging.dir}/${installer.source}"
                                              out="${staging.dir}/${installer.descriptor}"
                                              style="${basedir}/src/main/xslt/without-bundled-jre.xsl"
                                              force="true"/>

                                        <!-- The stylesheet matches by content.  If a descriptor
                                             edit ever stops it matching, stop here instead of
                                             shipping a "no JRE" installer that still bundles
                                             one, or that never asks for a JDK. -->
                                        <fail message="${installer.descriptor} still references packs/jre/">
                                            <condition>
                                                <resourcecontains resource="${staging.dir}/${installer.descriptor}"
                                                                  substring="packs/jre/"/>
                                            </condition>
                                        </fail>
                                        <fail message="${installer.descriptor} has no JDKPathPanel">
                                            <condition>
                                                <not>
                                                    <resourcecontains resource="${staging.dir}/${installer.descriptor}"
                                                                      substring="classname=&quot;JDKPathPanel&quot;"/>
                                                </not>
                                            </condition>
                                        </fail>
                                        <fail message="${installer.descriptor} does not set jdkhome from jdkPath">
                                            <condition>
                                                <not>
                                                    <resourcecontains resource="${staging.dir}/${installer.descriptor}"
                                                                      substring="name=&quot;jdkhome&quot; value=&quot;$${jdkPath}&quot;"/>
                                                </not>
                                            </condition>
                                        </fail>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <developers>
        <developer>
            <id>aynur</id>
            <name>Aynur Abdurazik</name>
            <email>aynur.abdurazik@nasa.gov</email>
            <organization>NASA Ocean Ecology Lab</organization>
            <timezone>-4</timezone>
        </developer>
    </developers>

    <build>
        <defaultGoal>package</defaultGoal>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.izpack</groupId>
                    <artifactId>izpack-maven-plugin</artifactId>
                    <version>${izpack.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>2.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>2.6</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>2.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>2.3</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>

            <!-- copy all resources to the staging directory. -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-resources</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${staging.dir}</outputDirectory>
                            <resources>

                                <resource>
                                    <directory>../../../snap-desktop/snap-application/target/snap</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                    <targetPath>../../src/main/izpack/packs/snap</targetPath>
                                    <filtering>false</filtering>
                                </resource>

                                <resource>
                                    <directory>../../../optical-toolbox/opttbx-kit/target/netbeans_clusters/opttbx</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                    <targetPath>../../src/main/izpack/packs/opttbx</targetPath>
                                    <filtering>false</filtering>
                                </resource>

                                <resource>
                                    <directory>../../../seadas-toolbox/seadas-kit/target/netbeans_clusters/seadas</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                    <targetPath>../../src/main/izpack/packs/seadas</targetPath>
                                    <filtering>false</filtering>
                                </resource>

                                <resource>
                                    <directory>src/main/izpack</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>

                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- copy izpack custom (custom panels, etc.) jars to izpack staging custom -->
                        <id>copy-izpack-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${staging.dir}/custom</outputDirectory>
                            <excludeTransitive>false</excludeTransitive>
                            <stripVersion>true</stripVersion>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                            <!-- IMPORTANT: this causes *only* our custom panels to be copied -->
                            <includeArtifactIds>izpack-panels</includeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- IzPack: build the installer JAR -->
            <plugin>
                <groupId>org.codehaus.izpack</groupId>
                <artifactId>izpack-maven-plugin</artifactId>
                <version>${izpack.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>izpack</goal>
                        </goals>
                        <configuration>
                            <!-- base for relative paths in izpack descriptor -->
                            <baseDir>${staging.dir}</baseDir>
                            <installFile>${staging.dir}/${installer.descriptor}</installFile>

                            <!-- Output: target/seadas-installer.jar -->
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <finalName>${installer-output-filename}</finalName>
                            <!-- no classifier, so the file name is exactly finalName.jar -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
